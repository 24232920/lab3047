<!DOCTYPE html>
<html>

<head>
    <title>Bookings</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
</head>

<body>
    <table>
        <tr>
            <td>
                <%= booking.email %>
            </td>
            <td>
                <%= booking.numTickets %>
            </td>
            <td>
                <%= booking.superhero %>
            </td>
        </tr>
    </table>

    <form method="POST" action="/booking/delete/<%= booking._id %>">
        <button type="submit" class="btn btn-primary">Delete</button>
    </form>
</body>

</html>